# Copy to .env and fill in. Read by the /api functions (`npm run dev:full`)
# and by scripts/smoke-test.ts. On Vercel, set the same two under
# Project → Settings → Environment Variables.
#
# Supabase → Project Settings → API. The service-role key is SERVER-ONLY:
# never prefix it with VITE_, never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
