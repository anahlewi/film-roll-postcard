{
  "name": "roll-24",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A 35mm contact strip you load with photos and send to one person.",
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "content": "tsx scripts/fetch-content.ts",
    "prebuild": "tsx scripts/fetch-content.ts || echo \"(no CMS env — building with the seed roll)\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@sanity/client": "^6.24.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vercel": "^60.1.3",
    "vite": "^6.0.5"
  }
}
