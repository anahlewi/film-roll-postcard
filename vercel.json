{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/r/:slug", "destination": "/index.html" },
    { "source": "/demo", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/r/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
